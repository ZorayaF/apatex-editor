{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core": ["frontend/src/core"],
      "@core/*": ["frontend/src/core/*"],

      "@editor": ["frontend/src/features/editor"],
      "@editor/*": ["frontend/src/features/editor/*"],

      "@store": ["frontend/src/features/editor/store"],
      "@store/*": ["frontend/src/features/editor/store/*"],

      "@hooks": ["frontend/src/features/editor/hooks"],
      "@hooks/*": ["frontend/src/features/editor/hooks/*"],

      "@config": ["frontend/src/features/editor/components/config"],
      "@config/*": ["frontend/src/features/editor/components/config/*"],

      "@writer": ["frontend/src/features/editor/components/writer"],
      "@writer/*": ["frontend/src/features/editor/components/writer/*"],

      "@logic": ["frontend/src/features/editor/logic"],
      "@logic/*": ["frontend/src/features/editor/logic/*"],

      "@pages": ["frontend/src/pages"],
      "@pages/*": ["frontend/src/pages/*"]
    }
  },
  "exclude": ["node_modules", "dist", "release"]
}
